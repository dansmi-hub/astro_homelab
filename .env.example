# ==============================================================================
# ASTRO HOMELAB ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual values.
# DO NOT COMMIT THE REAL .env FILE TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# Host System Configuration
# ------------------------------------------------------------------------------
ASTRO_HOST_IP=192.168.1.219
TZ=America/New_York
PUID=99
PGID=100

# ------------------------------------------------------------------------------
# Local DNS Stack (Pi-hole + Unbound)
# ------------------------------------------------------------------------------
PIHOLE_PASSWORD=ChangeMe_PiholeAdminPassword
PIHOLE_WEB_PORT=8053
DNS_PORT=53

# ------------------------------------------------------------------------------
# Reverse Proxy (Nginx Proxy Manager)
# ------------------------------------------------------------------------------
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=8182

# ------------------------------------------------------------------------------
# Homepage Dashboard API Keys & Integration Variables
# ------------------------------------------------------------------------------
# Plex Media Server
HOMEPAGE_VAR_PLEX_TOKEN=your_plex_token_here

# Tautulli
HOMEPAGE_VAR_TAUTULLI_API_KEY=your_tautulli_api_key_here

# Audiobookshelf
HOMEPAGE_VAR_AUDIOBOOKSHELF_TOKEN=your_audiobookshelf_api_token_here

# Arr Stack (Sonarr, Radarr, Prowlarr)
HOMEPAGE_VAR_SONARR_API_KEY=your_sonarr_api_key_here
HOMEPAGE_VAR_RADARR_API_KEY=your_radarr_api_key_here
HOMEPAGE_VAR_PROWLARR_API_KEY=your_prowlarr_api_key_here

# Downloaders & Indexers
HOMEPAGE_VAR_QBITTORRENT_USERNAME=admin
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=your_qbittorrent_password_here

# Pi-hole Homepage Integration
HOMEPAGE_VAR_PIHOLE_PASSWORD=ChangeMe_PiholeAdminPassword
