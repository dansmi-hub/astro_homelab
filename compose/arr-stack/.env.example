# ==============================================================================
# ASTRO HOMELAB - ARR STACK & ACCESSORIES ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' in the same directory before deploying:
#   cp compose/arr-stack/.env.example compose/arr-stack/.env
#
# DO NOT COMMIT THE ACTUAL '.env' FILE CONTAINING SECRETS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# General Host Parameters (Unraid Defaults)
# ------------------------------------------------------------------------------
# PUID and PGID specify the user and group ID for file permissions in container volumes.
# On Unraid, user 'nobody' is 99 and group 'users' is 100.
PUID=99
PGID=100

# Timezone matching your local host environment
TZ=Europe/London

# Host IP Address of the Unraid Server ("Astro")
ASTRO_HOST_IP=192.168.1.219

# ------------------------------------------------------------------------------
# Network Settings & LAN Access
# ------------------------------------------------------------------------------
# Subnet mask for local LAN network access.
# CRITICAL NOTICE: The 'binhex-qbittorrentvpn' gateway container uses strict iptables firewall rules
# (killswitch) to ensure zero IP leaks. If LAN_NETWORK is omitted or incorrect, iptables will drop
# all incoming and outgoing WebUI traffic from local network devices, causing WebUI lockouts.
# For example, if your router assigns IP addresses in 192.168.1.x, set LAN_NETWORK=192.168.1.0/24.
LAN_NETWORK=192.168.1.0/24

# ------------------------------------------------------------------------------
# VPN Gateway Credentials & Settings (binhex-qbittorrentvpn)
# ------------------------------------------------------------------------------
# VPN account credentials provided by your VPN service provider (e.g., PIA, AirVPN, Mullvad, ExpressVPN, etc.)
VPN_USER=your_vpn_username_here
VPN_PASS=your_vpn_password_here

# VPN Provider name (e.g., 'custom', 'pia', 'airvpn', 'mullvad', 'expressvpn')
VPN_PROV=custom

# VPN Client protocol ('openvpn' or 'wireguard')
VPN_CLIENT=openvpn

# DNS Name Servers used inside the VPN container to prevent DNS leakage
NAME_SERVERS=1.1.1.1,1.0.0.1

# ------------------------------------------------------------------------------
# Application API Keys & Integration Tokens
# ------------------------------------------------------------------------------
# Generate or copy API keys from each application's Settings -> General tab.
# These keys allow Unpackerr and other services to trigger post-processing and extraction.
SONARR_API_KEY=your_sonarr_api_key_here
RADARR_API_KEY=your_radarr_api_key_here
PROWLARR_API_KEY=your_prowlarr_api_key_here
